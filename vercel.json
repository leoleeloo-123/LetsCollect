{
  "rewrites": [
    {
      "source": "/",
      "destination": "/hero-jelly-jade-toy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.+)\\.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
